<Project>
    <PropertyGroup>
        <!-- Версия плагина: единый источник (номер пакета, тег релиза, CI). -->
        <PluginVersion>0.6.1</PluginVersion>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RepositoryType>Git</RepositoryType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Единая версия для всех проектов: под-проекты получают ту же assembly-version. -->
        <Version>$(PluginVersion)</Version>
    </PropertyGroup>
</Project>
